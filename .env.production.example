# Copy to /opt/terravanta/.env.production on the production host and replace every placeholder.
# Use random hexadecimal strings for passwords so DATABASE_URL URL encoding is not required.
PUBLIC_DOMAIN=terravanta.example.com
IMAGE_PREFIX=ghcr.io/jaybe-123456/terravanta
IMAGE_TAG=replace-with-a-commit-sha
POSTGRES_PASSWORD=replace-with-random-64-character-hex
DEMO_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PARSE_MODEL=nvidia/nemotron-3.5-parse
NVIDIA_PARSE_URL=
NVIDIA_PARSE_API_KEY=
AI_TIMEOUT_SECONDS=35
