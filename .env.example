# Local Docker Compose values. Replace secrets before any shared deployment.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://terravanta:terravanta@localhost:5432/terravanta
POSTGRES_PASSWORD=replace-with-a-unique-local-password
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEMO_AUTH_SECRET=replace-with-at-least-32-random-characters
ENABLE_SYNTHETIC_DATA=false
# Use a dedicated Terravanta Supabase project; never point this at VetIOS.
SUPABASE_URL=
# SUPABASE_JWKS_URL can be left blank; the API derives the standard JWKS endpoint from SUPABASE_URL.
SUPABASE_JWKS_URL=
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PARSE_MODEL=nvidia/nemotron-3.5-parse
NVIDIA_PARSE_URL=
NVIDIA_PARSE_API_KEY=
UPLOADS_DIR=/app/data/uploads
AI_TIMEOUT_SECONDS=35
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST_PORT=8000
WEB_HOST_PORT=3000
