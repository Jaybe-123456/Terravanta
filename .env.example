# Local Docker Compose values. Replace secrets before any shared deployment.
APP_ENV=development
SERVICE_MODE=api
DATABASE_URL=postgresql+psycopg://terravanta:terravanta@localhost:5432/terravanta
# Local Compose uses the same PostgreSQL owner for migrations and API setup.
# Production: MIGRATIONS_DATABASE_URL is owner-only; DATABASE_URL is the restricted RLS runtime login.
MIGRATIONS_DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-unique-local-password
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_APP_ORIGIN=https://terravanta-five.vercel.app
DEMO_AUTH_SECRET=replace-with-at-least-32-random-characters
ENABLE_SYNTHETIC_DATA=false
# Use a dedicated Terravanta Supabase project; never point this at VetIOS.
SUPABASE_URL=
# SUPABASE_JWKS_URL can be left blank; the API derives the standard JWKS endpoint from SUPABASE_URL.
SUPABASE_JWKS_URL=
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SITE_URL=https://terravanta-five.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: set the token value from Google Search Console's HTML-tag verification.
GOOGLE_SITE_VERIFICATION=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PARSE_MODEL=nvidia/nemotron-3.5-parse
NVIDIA_PARSE_URL=
NVIDIA_PARSE_API_KEY=
UPLOADS_DIR=/app/data/uploads
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_LOCAL_STORAGE_PERSISTENT=false
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_ACCESS_KEY=
EVIDENCE_S3_SECRET_KEY=
EVIDENCE_MAX_FILE_BYTES=15000000
AI_TIMEOUT_SECONDS=35
WORKFLOW_POLL_SECONDS=30
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST_PORT=8000
WEB_HOST_PORT=3000
